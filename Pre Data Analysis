import pandas as pd
import requests 
import sqlite3
from math import pi
from sklearn.tree import DecisionTreeRegressor
from sklearn.metrics import mean_absolute_error 
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestRegressor

url = "https://data.cityofchicago.org/api/v3/views/4z7n-5k6z/query.json"
response = requests.get(url)
data = response.json()
city_data = pd.DataFrame(data)
city_data.to_csv("city_data.csv", index=False)
cd_read = pd.read_csv("city_data.csv")
column_names = list(cd_read.columns)

print(column_names)

city_data["wind_direction"] = pd.to_numeric(city_data["wind_direction"])
city_data['air_temperature'] = city_data['air_temperature'].astype('float64')
city_data['wind_direction'] = city_data['wind_direction'].astype('float64')
city_data['wind_speed'] = city_data['wind_speed'].astype('float64')
city_data['maximum_wind_speed'] = city_data['maximum_wind_speed'].astype('float64')
city_data['barometric_pressure'] = city_data['barometric_pressure'].astype('float64')

con = sqlite3.connect(":memory:")
cd_read.to_sql("city_of_chicago", con, index=False, if_exists="replace")

#for sqlite, using the three quote notation allows the string to be written across multiple lines, for better readability 
# you can leave them as one line with nothing inbetween, functions in all caps
query = """
SELECT station_name, air_temperature, wind_direction, wind_speed, maximum_wind_speed, barometric_pressure
FROM city_of_chicago"""
print(pd.read_sql_query(query, con)) 

                                    
wind_angle = """
SELECT wind_direction,
    wind_direction * 0.01745329251 AS wind_direction_rad
FROM city_of_chicago
LIMIT 10
"""

print(pd.read_sql_query(wind_angle, con))

y = city_data.wind_speed #This is my target 
wind_features = ['wind_direction', 'air_temperature', 'maximum_wind_speed', 'barometric_pressure']
x = city_data[wind_features]

city_model = DecisionTreeRegressor(random_state=1)
city_model.fit(x,y)

print("For the first points of data:")
print(x.head())
print("The predictions are")
print(city_model.predict(x.head()))

train_x, val_x, train_y, val_y = train_test_split(x, y, random_state = 0)
city_model = DecisionTreeRegressor(max_leaf_nodes= 48)
city_model.fit(train_x, train_y)
val_predictions = city_model.predict(val_x)
mean_absolute_error(val_y, val_predictions)
print(mean_absolute_error(val_y, val_predictions))

city2_model = RandomForestRegressor(random_state=1)
city2_model.fit(train_x, train_y)
preds2 = city2_model.predict(val_x)
print(mean_absolute_error(val_y, preds2))


